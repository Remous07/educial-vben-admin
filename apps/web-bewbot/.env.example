# ── 基础配置（对应 .env）───────────────────────────────

# 应用标题
VITE_APP_TITLE=Bewbot Admin

# 应用命名空间，用于缓存、store 等功能的前缀
VITE_APP_NAMESPACE=bewbot-admin

# 对 store 进行加密的密钥（生产环境请改为随机字符串）
VITE_APP_STORE_SECURE_KEY=change-me-to-a-random-string

# Cloudflare Turnstile 人机验证 Site Key
# 后端启用 TURNSTILE_SECRET_KEY 时这里必须填对应的 Site Key；
# 留空则登录/注册页不显示人机验证。
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── 开发环境补充（对应 .env.development）────────────────

# 开发服务器端口
# VITE_PORT=5678

# 部署基础路径（部署在子路径时修改）
# VITE_BASE=/

# 接口地址（开发走 Vite 代理，填 /api）
# VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock（false 则走 Vite 代理到 Python 后端）
# VITE_NITRO_MOCK=false

# 是否打开 devtools
# VITE_DEVTOOLS=false

# 是否注入全局 loading
# VITE_INJECT_APP_LOADING=true

# ── 生产环境补充（对应 .env.production）──────────────────

# 部署基础路径
# VITE_BASE=/

# 生产接口地址（部署到后端同域可填 /api，独立域名填 https://你的域名/api）
# VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock
# VITE_NITRO_MOCK=false

# 是否打开 devtools
# VITE_DEVTOOLS=false

# 是否注入全局 loading
# VITE_INJECT_APP_LOADING=true

# 打包后是否生成 dist.zip
# VITE_ARCHIVER=true
