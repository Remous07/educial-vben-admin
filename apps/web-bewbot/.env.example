# ============================================================
# 管理面板（Vben Admin）环境配置模板
# 使用：把本文件分别复制为 .env、.env.development、.env.production
#   cp .env.example .env
#   cp .env.example .env.development
#   cp .env.example .env.production
# 然后按注释填写（只留需要的键，其余删掉或保持注释）。
#
# Vite 加载机制：运行/打包时 = 基础 .env + 对应模式的 .env.[mode]
#   pnpm -F @vben/web-bewbot run dev   → .env + .env.development
#   pnpm build                         → .env + .env.production
# 同名键以后者为准。
# ============================================================

# ── 基础配置（三个文件都要放，公共部分）────────────────────

# 浏览器标签页标题
VITE_APP_TITLE=Bewbot Admin

# 应用命名空间，作为 localStorage/store 等的前缀，避免与同域其他应用冲突
VITE_APP_NAMESPACE=bewbot-admin

# 对 store 持久化数据加密的密钥。生产必须改为随机字符串：
#   openssl rand -hex 16
VITE_APP_STORE_SECURE_KEY=change-me-to-a-random-string

# Cloudflare Turnstile 人机验证 Site Key（公钥）
# 与后端 .env 的 TURNSTILE_SECRET_KEY（私钥）成对使用，需在同一站点创建。
# 两个都填 → 登录/注册页显示人机验证；留空 → 不显示。
# 获取：Cloudflare Dashboard → Turnstile → 创建站点后得到 Site Key / Secret Key。
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── 开发环境（.env.development）────────────────────────────

# 开发服务器端口（浏览器访问 http://localhost:5678）
# VITE_PORT=5678

# 部署基础路径。根路径填 /；部署在子路径（如 https://域名/admin）填 /admin/
# VITE_BASE=/

# 接口地址。开发时填 /api，由 Vite 代理转发到 Python 后端
#（代理规则在 vite.config.ts，目标即后端 BACKEND_URL）。
# VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock 服务。false = 走真实后端；true = 用内置模拟数据
# VITE_NITRO_MOCK=false

# 是否打开页面调试工具（devtools）
# VITE_DEVTOOLS=false

# 是否注入全局 loading 动画
# VITE_INJECT_APP_LOADING=true

# ── 生产环境（.env.production）─────────────────────────────

# 部署基础路径（同开发说明）
# VITE_BASE=/

# 接口地址（关键）：
#   - 后端与前端同域部署（Nginx 把 /api 反代给后端）→ 填 /api
#   - 前后端不同域名 → 填后端完整地址，如 https://bewbot.vmox.net/api
# 注意必须能被浏览器直接访问，不能是 localhost。
# VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock（生产一般 false）
# VITE_NITRO_MOCK=false

# 是否打开 devtools
# VITE_DEVTOOLS=false

# 是否注入全局 loading
# VITE_INJECT_APP_LOADING=true

# 打包后是否额外生成 dist.zip
# VITE_ARCHIVER=true
