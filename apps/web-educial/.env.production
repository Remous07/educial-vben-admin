VITE_BASE=/

# 接口地址 - 生产环境指向Java后端
VITE_GLOB_API_URL=https://api.educial.net

# 是否开启压缩
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

VITE_NITRO_MOCK=false

# Cloudflare Turnstile 站点密钥
VITE_TURNSTILE_SITE_KEY=0x4AAAAAABhMC4t6Cc0p9bX0
